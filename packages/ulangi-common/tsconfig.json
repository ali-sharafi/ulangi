{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "noImplicitAny": true,
    "declaration": true,
    "strictNullChecks": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "typeRoots": ["./node_modules/@types", "./@types"],
    "experimentalDecorators": true,
    "resolveJsonModule": true,
  },
  "include": [
    "src/**/*.ts"
  ]
}

