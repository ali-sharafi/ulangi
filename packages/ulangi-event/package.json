{
  "name": "@ulangi/ulangi-event",
  "version": "3.21.0",
  "description": "Ulangi Event",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/",
    "lint-fix": "eslint --fix src/",
    "pretest": "tsc -p ./tsconfig.test.json",
    "test": "npx jest",
    "clean": "rm -rf ./dist",
