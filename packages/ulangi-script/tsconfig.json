{
  "compilerOptions": {
    "lib": ["es6", "ES2020"],
    "types": ["node"],
    "module": "commonjs",
    "noImplicitReturns": true,
    "strict": true,
    "strictNullChecks": true,
    "outDir": "bin",
    "rootDir": "src",
    "sourceMap": false,
    "target": "es6",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "aws-sdk": ["./node_modules/aws-sdk"]
    }
  },
  "compileOnSave": true,
  "include": [
    "src",
    "configs.json"
  ]
}
